# Keep the build context small and free of host build artifacts. Note: the Rust
# .sqlx offline cache (server/.sqlx) is deliberately NOT ignored — it is needed
# for the SQLX_OFFLINE=true build.

.git
.github

# Rust / Node build outputs (rebuilt inside the image).
server/target
web/node_modules
web/dist

# Local runtime data (SQLite db + uploaded media).
server/data

# Host-only deploy config (not part of the runtime image).
deploy

# Misc.
**/.DS_Store
**/*.log
