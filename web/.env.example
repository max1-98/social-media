# Frontend environment variables (Vite). Copy to `.env.local` and fill in.
# Only VITE_-prefixed vars are exposed to client code. NEVER commit real ids.
#
# Ads + consent (GDPR — .claude/rules/gdpr.md): all are OPTIONAL. When unset,
# no AdSense/CMP script loads at all (AdSlot renders a neutral placeholder), so
# dev/test never leak a non-essential request.

# AdSense publisher client id, e.g. ca-pub-0000000000000000
VITE_ADSENSE_CLIENT=

# Default AdSense ad slot id used by <AdSlot/> when no `slot` prop is passed.
VITE_ADSENSE_SLOT=

# Google certified CMP (Funding Choices / "Privacy & messaging") publisher id.
# Usually the publisher id without the leading "ca-", e.g. pub-0000000000000000.
VITE_CMP_PUB_ID=
