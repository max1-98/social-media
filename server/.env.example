# server/ (Rust + Axum) configuration. Copy to `.env` for local dev.
# All keys are optional — sensible defaults let the binary run with zero config.

# SQLite connection string. The DB is created + migrated on startup.
# Also read at COMPILE TIME by the sqlx query macros (CI uses the committed
# .sqlx/ offline cache via SQLX_OFFLINE=true instead).
DATABASE_URL=sqlite://data/app.db

# Transactional email (Resend). When unset, email sending is a logged no-op.
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com

# Base URL of the frontend, used to build verification / reset links.
FRONTEND_BASE_URL=http://localhost:3000

# GDPR age gate: registrants younger than this are flagged for parental consent.
DIGITAL_CONSENT_AGE=16

# Session token lifetimes (seconds). Defaults mirror the legacy OAuth2 settings.
ACCESS_TOKEN_TTL_SECS=360000
REFRESH_TOKEN_TTL_SECS=2592000
# Email-verify / password-reset token TTL (seconds). Legacy: 3 hours.
SHORT_TOKEN_TTL_SECS=10800

# Set the Secure flag on auth cookies. Keep true in production (HTTPS); set
# false for local HTTP dev.
COOKIE_SECURE=true

# HTTP listen port (default 8080).
PORT=8080
