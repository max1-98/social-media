# Production environment for social-media (EnvironmentFile in the systemd unit).
#
# Copy to /etc/social-media/social-media.env, fill real values, chmod 600,
# chown social:social. NEVER commit the filled-in file. All keys map to
# server/src/config.rs (Config::from_env).

# --- Core -----------------------------------------------------------------
PORT=8080
DATABASE_URL=sqlite:///var/lib/social-media/app.db
COOKIE_SECURE=true
FRONTEND_BASE_URL=https://example.com

# --- Media (local disk; served via signed URLs) ---------------------------
MEDIA_DIR=/var/lib/social-media/media
MEDIA_BASE_URL=https://example.com/media
# Generate a strong random secret, e.g. `openssl rand -hex 32`.
MEDIA_SECRET=__REPLACE_WITH_RANDOM_32_BYTE_HEX__

# --- Email (Resend) -------------------------------------------------------
RESEND_API_KEY=__REPLACE__
EMAIL_FROM=no-reply@example.com

# --- Geocoding (Nominatim policy requires a contactable UA) ----------------
GEOCODER_USER_AGENT=social-media/1.0 (admin@example.com)

# --- GDPR ------------------------------------------------------------------
DIGITAL_CONSENT_AGE=16

# --- Litestream -> R2 (read by litestream.yml, not the binary) -------------
LITESTREAM_ACCESS_KEY_ID=__REPLACE__
LITESTREAM_SECRET_ACCESS_KEY=__REPLACE__
